# Optional; scripted mode never calls an LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
LLM_MODE=scripted
OPEN_METEO_CACHE_ONLY=1
ISSUE_HOUR_UTC=18
# ECMWF availability is fixed per cycle in windagent/clock.py: 8/7/8/7 h.
AVAIL_LAG_HOURS=7
REISSUE_ON_NEW_RUN=1
DIVERGENCE_THRESHOLD_MS=1.5
SCADA_TZ_OFFSET_HOURS=6
HORIZON_HOURS=48
POINT_ESTIMATE=median
# Planned event-loop thresholds (LOC-24), not yet executed by issue CLI.
RESIDUAL_Z_THRESHOLD=2.5
RESIDUAL_WINDOW_HOURS=6
DRIFT_WINDOW_DAYS=14
